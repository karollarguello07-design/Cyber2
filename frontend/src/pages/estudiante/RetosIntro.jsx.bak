import introImg from '../../assets/ilustraciones/retos-intro.svg';
import './RetosIntro.css';

const REQUISITOS = [
  {
    titulo: '1. Un sistema Linux (Debian o derivado)',
    texto:
      'Todos los retos se practican desde una terminal de Linux: puede ser tu propia distribución Debian, ' +
      'Linux Mint o Kali, en una máquina virtual o en el computador de la universidad. En Windows no vienen ' +
      'preinstaladas las herramientas que vamos a usar.',
  },
  {
    titulo: '2. Abrir una terminal',
    texto:
      'Busca "Terminal" en el menú de aplicaciones, o usa el atajo Ctrl + Alt + T. Ahí vas a escribir todos ' +
      'los comandos de cada reto.',
  },
  {
    titulo: '3. Actualizar los paquetes del sistema',
    comando: 'sudo apt update',
  },
  {
    titulo: '4. Instalar Nmap (para el reto de escaneo de puertos)',
    comando: 'sudo apt install nmap -y',
  },
  {
    titulo: '5. Instalar Hydra (para los retos de fuerza bruta y diccionario)',
    comando: 'sudo apt install hydra -y',
  },
  {
    titulo: '6. Verificar que el cliente SSH ya está instalado',
    texto: 'Casi todas las distribuciones ya lo traen. Si el comando falla, instálalo con el segundo comando.',
    comando: 'ssh -V\nsudo apt install openssh-client -y',
  },
];

function RetosIntro({ onIniciar }) {
  return (
    <div className="retos-intro">
      <div className="retos-intro-hero">
        <img src={introImg} alt="Terminal con un reto de ciberseguridad" className="retos-intro-imagen" />
        <h1>🗡️ Zona de Retos</h1>
        <p>
          Pon en práctica lo que aprendiste en los módulos, resolviendo retos basados en
          ataques reales capturados por nuestro honeypot Cowrie.
        </p>
        <button className="retos-intro-boton" onClick={onIniciar}>
          ▶ Iniciar retos
        </button>
      </div>

      <div className="retos-intro-requisitos">
        <h2>🧰 Requisitos previos</h2>
        <p className="retos-intro-requisitos-nota">
          Antes de practicar, prepara tu sistema. Todo se hace desde una terminal de <strong>Linux (Debian o
          una distribución basada en Debian, como Kali o Linux Mint)</strong>.
        </p>

        <div className="retos-intro-pasos">
          {REQUISITOS.map((paso, i) => (
            <div key={i} className="retos-intro-paso">
              <h3>{paso.titulo}</h3>
              {paso.texto && <p>{paso.texto}</p>}
              {paso.comando && (
                <pre className="retos-intro-comando">{paso.comando}</pre>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

export default RetosIntro;
